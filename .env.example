# =============================================================================
# Скопируй в `.env` и заполни значения.
# Файл `.env` в git не попадает.
# =============================================================================

# --- Приложение (фронт, префикс VITE_) ---

VITE_API_URL=https://api.igragolovoy.ru/api/v1
VITE_WS_URL=wss://api.igragolovoy.ru/ws
VITE_USE_MOCKS=true
VITE_MOCK_TELEGRAM=true

# --- /test-yandex: фронт (npm run dev) ---

VITE_YANDEX_API_KEY=
VITE_YANDEX_FOLDER_ID=

# --- /test-yandex: serverless api (Vercel / npm run dev:vercel) ---
# На Vercel в дашборде задай ТОЛЬКО эти два (без VITE_ для ключа).
# Локально можно продублировать значения из VITE_* выше.

YANDEX_API_KEY=
YANDEX_FOLDER_ID=

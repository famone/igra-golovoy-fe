# =============================================================================
# Скопируй в `.env` и заполни значения.
# Файл `.env` в git не попадает.
# =============================================================================

# --- Приложение (фронт, префикс VITE_) ---

VITE_API_URL=https://api.igragolovoy.ru/api/v1
VITE_WS_URL=wss://api.igragolovoy.ru/ws
VITE_USE_MOCKS=true
VITE_MOCK_TELEGRAM=true

# --- Судья /test-yandex. Ключи только на сервере, без префикса VITE_. ---
# OpenAI: https://platform.openai.com/api-keys
# Модель по умолчанию gpt-6-luna. Другую можно подставить сюда.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Live Football API: https://www.live-football-api.com
FOOTBALL_API_KEY=

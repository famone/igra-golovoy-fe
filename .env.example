# REST API мини-приложения
VITE_API_URL=https://api.igragolovoy.ru/api/v1

# WebSocket-шлюз игровых событий
VITE_WS_URL=wss://api.igragolovoy.ru/ws

# Пока бэкенда нет: сторы отдают данные из src/stores/*/mocks.ts
VITE_USE_MOCKS=true

# Имитация окружения Telegram при разработке в обычном браузере
VITE_MOCK_TELEGRAM=true

# Песочница /test-yandex: ключ AI Studio (не коммитить .env)
VITE_YANDEX_API_KEY=
VITE_YANDEX_FOLDER_ID=

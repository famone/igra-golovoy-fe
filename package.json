    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "lottie-web": "^5.13.0",
    "pinia": "^2.3.0",
    "tailwind-merge": "^2.6.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue3-toastify": "^0.2.8"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.12.1",
    "@tailwindcss/vite": "^4.0.0",
